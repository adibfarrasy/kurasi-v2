-- allium: 3
-- onboarding.allium

-- Scope: the post-signup flow that gates entry to the main app. A User is
-- considered onboarded once they have set biometrics and added the minimum
-- starter wardrobe.
--
-- Includes:
--   - OnboardingProgress per user (tracks which steps are done)
--   - Starter wardrobe threshold (minimum items to finish onboarding)
--   - Derived readiness predicate used by main-app surfaces
-- Excludes:
--   - Welcome/USP carousel UI (pure presentation)
--   - The signup step itself (see auth.allium)
--   - Biometrics capture details (see fit-page.allium: SetBiometrics)
--   - Wardrobe item upload (see wardrobe.allium: AddWardrobeItem)
--   - Style board onboarding (currently users engage with style-board after
--     onboarding completes)

use "./auth.allium" as auth
use "./wardrobe.allium" as wardrobe
use "./fit-page.allium" as fit

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum OnboardingStep {
    biometrics
    | starter_wardrobe
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity OnboardingProgress {
    user: auth/User
    started_at: Timestamp
    biometrics_completed_at: Timestamp?
    starter_wardrobe_completed_at: Timestamp?
    -- decision: onboarding is a one-shot gate. Once status = completed it
    -- stays there forever, regardless of later wardrobe deletions dropping
    -- the user below min_starter_items. There is no transition back to
    -- in_progress.
    status: in_progress | completed

    transitions status {
        in_progress -> completed
        terminal: completed
    }

    completed_at: Timestamp when status = completed

    -- Derived: has the user satisfied each step?
    biometrics_done: biometrics_completed_at != null
    starter_wardrobe_done: starter_wardrobe_completed_at != null
    all_steps_done: biometrics_done and starter_wardrobe_done
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- decision: 5 items minimum, aligned with
    -- fit-page.min_wardrobe_items_for_recommendations and
    -- social-share.min_items_to_unlock_sharing.
    min_starter_items: Integer = 5
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- When an account becomes active (post email verification, or immediately for
-- OAuth), the user has onboarding to complete.
rule BeginOnboarding {
    when: user: auth/User.status becomes active
    requires: not exists OnboardingProgress{user: user}
    ensures: OnboardingProgress.created(
        user: user,
        started_at: now,
        status: in_progress
    )
}

-- When the user sets their biometrics for the first time, the biometrics step
-- is marked done.
rule CompleteBiometricsStep {
    when: biometrics: fit/UserBiometrics.created
    let progress = OnboardingProgress{user: biometrics.user}
    requires: exists progress
    requires: progress.status = in_progress
    requires: progress.biometrics_completed_at = null
    ensures: progress.biometrics_completed_at = now
}

-- When the user's active wardrobe reaches the starter threshold, mark the
-- wardrobe step done. Triggered on each new item creation; the guard prevents
-- re-firing once the step is already complete.
rule CompleteStarterWardrobeStep {
    when: item: wardrobe/WardrobeItem.created
    let progress = OnboardingProgress{user: item.owner}
    requires: exists progress
    requires: progress.status = in_progress
    requires: progress.starter_wardrobe_completed_at = null
    let owned_items = wardrobe/WardrobeItems where
        owner = item.owner and status = active
    requires: owned_items.count >= config.min_starter_items
    ensures: progress.starter_wardrobe_completed_at = now
}

-- When both steps are done, onboarding completes and the user lands in the
-- main app.
rule CompleteOnboarding {
    when: progress: OnboardingProgress.all_steps_done
    requires: progress.status = in_progress
    ensures:
        progress.status = completed
        progress.completed_at = now
        OnboardingCompleted(user: progress.user)
}

-- decision: account deletion hard-deletes the user's OnboardingProgress.
rule CascadeUserDeletionToOnboarding {
    when: UserDeleted(deleted_user)
    let progress = OnboardingProgress where user = deleted_user
    ensures:
        for p in progress: not exists p
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneProgressPerUser {
    for a in OnboardingProgress:
        for b in OnboardingProgress:
            a != b implies a.user != b.user
}

invariant CompletedImpliesStepsDone {
    for p in OnboardingProgress:
        p.status = completed implies
            p.biometrics_completed_at != null
            and p.starter_wardrobe_completed_at != null
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor OnboardingUser {
    identified_by: auth/User where status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface OnboardingFlow {
    facing user: OnboardingUser

    context progress: OnboardingProgress where status = in_progress

    let owned_items = wardrobe/WardrobeItems where
        owner = progress.user and status = active

    exposes:
        progress.biometrics_done
        progress.starter_wardrobe_done
        progress.all_steps_done
        owned_items.count

    @guidance
        -- The onboarding surface is informational. Step actions live on
        -- surfaces owned by other specs:
        --   - biometrics: SetBiometrics on fit-page FitPage surface
        --   - starter wardrobe: AddWardrobeItem on wardrobe WardrobeBrowse surface
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should a face photo ever be a required onboarding step for some app variants (e.g. premium), or is it forever optional?"
open question "Does onboarding include a style-board seeding step (swipe a few cards before entering the app), or is style-board engagement purely post-onboarding as modelled here?"
