-- allium: 3
-- payments.allium

-- Scope: the monetisation flow. Every new User gets a 7-day trial starting at
-- account creation (see auth.allium). When the trial ends the user must hold
-- an active monthly subscription to continue using the app; otherwise access
-- lapses.
--
-- Includes:
--   - Subscription lifecycle (trial -> active / lapsed -> active / cancelled)
--   - Paywall enforcement (when a user has access)
--   - Monthly billing cycle (renewal, failure)
-- Excludes:
--   - Specific payment processor choice (Stripe, Apple IAP, Google Play Billing
--     are implementation)
--   - Proration, refunds, promo codes (out of scope for MVP spec)
--   - Tax handling

use "./auth.allium" as auth

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum BillingInterval {
    monthly
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Subscription {
    user: auth/User
    interval: BillingInterval
    started_at: Timestamp
    current_period_end: Timestamp
    -- decision: cancelling mid-period preserves access until
    -- current_period_end. On failed renewal the sub enters `grace` for
    -- config.grace_period (3 days) before lapsing. is_current below
    -- reflects both.
    status: active | grace | cancelled | lapsed

    transitions status {
        active -> grace
        active -> cancelled
        grace -> active
        grace -> lapsed
        lapsed -> active
        cancelled -> active
        terminal: lapsed
    }

    cancelled_at: Timestamp when status = cancelled
    lapsed_at: Timestamp when status = lapsed
    grace_started_at: Timestamp when status = grace
    grace_ends_at: Timestamp when status = grace

    -- decision: access is retained through the paid period after cancel,
    -- and through the 3-day grace window on a failed renewal.
    is_current:
        (status = active and now < current_period_end)
        or (status = cancelled and now < current_period_end)
        or (status = grace and now < grace_ends_at)
}

-- A user's access to the app at any moment is a function of their trial state
-- and subscription state. Modelled as a derived predicate rather than a
-- separate entity.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    billing_period: Duration = 30.days
    trial_duration: Duration = auth/config.trial_duration
    -- decision: 3-day grace window between a failed renewal attempt and the
    -- subscription lapsing. During grace, is_current remains true.
    grace_period: Duration = 3.days
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- User converts (pays) during or after trial. If they are still in trial, the
-- subscription activates and extends access from now forward.
rule StartSubscription {
    when: StartSubscription(user)
    requires: user.status = active
    requires: not exists Subscription{user: user}
    ensures: Subscription.created(
        user: user,
        interval: monthly,
        started_at: now,
        current_period_end: now + config.billing_period,
        status: active
    )
}

-- Renewal at the end of a billing period: payment succeeded, period advances.
rule RenewSubscription {
    when: subscription: Subscription.current_period_end <= now
    requires: subscription.status = active
    requires: RenewalPaymentSucceeded(subscription)
    ensures:
        subscription.current_period_end = subscription.current_period_end + config.billing_period
}

-- decision: renewal payment failure at the end of a billing period moves
-- the subscription into grace for config.grace_period. Access (is_current)
-- remains true during grace.
rule EnterGraceOnFailedRenewal {
    when: subscription: Subscription.current_period_end <= now
    requires: subscription.status = active
    requires: not RenewalPaymentSucceeded(subscription)
    ensures:
        subscription.status = grace
        subscription.grace_started_at = now
        subscription.grace_ends_at = now + config.grace_period
}

-- Payment retried successfully during the grace window: resume active.
rule RecoverFromGrace {
    when: RecoverFromGrace(subscription)
    requires: subscription.status = grace
    ensures:
        subscription.status = active
        subscription.grace_started_at = null
        subscription.grace_ends_at = null
        subscription.current_period_end = now + config.billing_period
}

-- decision: grace expires without successful payment: subscription lapses.
rule LapseAfterGrace {
    when: subscription: Subscription.grace_ends_at <= now
    requires: subscription.status = grace
    ensures:
        subscription.status = lapsed
        subscription.lapsed_at = now
        subscription.grace_started_at = null
        subscription.grace_ends_at = null
}

-- Lapsed user pays again: subscription resumes.
rule ReactivateSubscription {
    when: ReactivateSubscription(subscription)
    requires: subscription.status = lapsed
    ensures:
        subscription.status = active
        subscription.lapsed_at = null
        subscription.current_period_end = now + config.billing_period
}

-- decision: cancelling sets status = cancelled immediately but is_current
-- stays true until current_period_end, so access continues through the
-- paid-for period. Consumers must check is_current, not status alone.
rule CancelSubscription {
    when: CancelSubscription(user)
    requires: user.status = active
    let subscription = Subscription{user: user}
    requires: exists subscription
    requires: subscription.status in {active, grace}
    let was_in_grace = subscription.status = grace
    ensures:
        subscription.status = cancelled
        subscription.cancelled_at = now
        if was_in_grace:
            subscription.grace_started_at = null
            subscription.grace_ends_at = null
}

-- decision: account deletion hard-deletes the user's Subscription record.
rule CascadeUserDeletionToSubscription {
    when: UserDeleted(deleted_user)
    let subs = Subscriptions where user = deleted_user
    ensures:
        for s in subs: not exists s
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneSubscriptionPerUser {
    for a in Subscriptions:
        for b in Subscriptions:
            a != b implies a.user != b.user
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Subscriber {
    identified_by: auth/User where status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Paywall {
    facing holder: Subscriber

    context user: auth/User where status = active

    let subscription = Subscription{user: user}

    exposes:
        user.trial_ends_at
        user.is_in_trial
        subscription

    provides:
        StartSubscription(user) when not exists subscription
        ReactivateSubscription(subscription)
            when exists subscription and subscription.status = lapsed
        RecoverFromGrace(subscription)
            when exists subscription and subscription.status = grace
        CancelSubscription(user)
            when exists subscription and subscription.status in {active, grace}
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "How is RenewalPaymentSucceeded signalled to the system: as a payment processor webhook (external), or does the spec model the attempt itself?"
