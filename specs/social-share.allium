-- allium: 3
-- social-share.allium

-- Scope: generation and distribution of shareable cards for external social
-- platforms (Instagram Story, Snapchat, TikTok, Twitter/X, copy link). The
-- internal "publish to Discover feed" flow is governed by fit-page.allium.
--
-- Includes:
--   - ShareableCard: a generated share asset (outfit, wardrobe showcase, or
--     style stats)
--   - ShareEvent: a record of the user posting a card to a given platform
--   - ShareClick: an inbound click from a shared link (referral tracking)
--   - Gating: minimum wardrobe size to unlock sharing
-- Excludes:
--   - Card image rendering (black-box; domain cares about dimensions and the
--     card's content identity, not rendering technology)
--   - Platform SDK integration specifics
--   - UTM/tracking parameter wire format

use "./auth.allium" as auth
use "./wardrobe.allium" as wardrobe
use "./fit-page.allium" as fit

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum SharePlatform {
    instagram_story
    | snapchat
    | tiktok
    | twitter
    | clipboard
}

enum ShowcaseMode {
    by_category
    | by_color
    | by_style
    | entire_wardrobe
}

enum StatsPeriod {
    week
    | month
    | year
}

enum CardTheme {
    light
    | dark
    | colorful
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity ShareableCard {
    owner: auth/User
    kind: OutfitCard | WardrobeShowcaseCard | StyleStatsCard
    theme: CardTheme
    caption: String?
    created_at: Timestamp
    status: live | expired

    transitions status {
        live -> expired
        terminal: expired
    }

    expired_at: Timestamp when status = expired

    share_events: ShareEvent with card = this
    share_count: share_events.count

    click_events: ShareClick with card = this
    click_count: click_events.count
}

variant OutfitCard : ShareableCard {
    outfit: wardrobe/Outfit
}

variant WardrobeShowcaseCard : ShareableCard {
    showcase_mode: ShowcaseMode
    -- If showcase_mode = by_category, a category filter is required; if
    -- by_color, a color; if by_style, a style tag. Modelled loosely as
    -- optional discriminator keys rather than a second sum type.
    category_filter: wardrobe/ItemCategory?
    color_filter: String?
    style_filter: String?
}

variant StyleStatsCard : ShareableCard {
    period: StatsPeriod
}

entity ShareEvent {
    card: ShareableCard
    platform: SharePlatform
    occurred_at: Timestamp
}

entity ShareClick {
    card: ShareableCard
    platform: SharePlatform
    occurred_at: Timestamp
    converted_to_signup: Boolean
    referred_user: auth/User?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- decision: unlock threshold resolved to 5 (not 10). Matches the
    -- recommendations threshold in fit-page for a single, consistent
    -- "minimum viable wardrobe" concept across the product.
    min_items_to_unlock_sharing: Integer = 5
    card_ttl: Duration = 90.days
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Generate an outfit card. Gated by the minimum-wardrobe threshold.
rule GenerateOutfitCard {
    when: GenerateOutfitCard(user, outfit, theme, caption?)
    requires: user.status = active
    requires: outfit.owner = user
    requires: outfit.status = active
    let owned_items = wardrobe/WardrobeItems where
        owner = user and status = active
    requires: owned_items.count >= config.min_items_to_unlock_sharing
    ensures: OutfitCard.created(
        owner: user,
        outfit: outfit,
        theme: theme,
        caption: caption,
        status: live,
        created_at: now
    )
}

rule GenerateWardrobeShowcaseCard {
    when: GenerateWardrobeShowcaseCard(
        user,
        showcase_mode,
        theme,
        caption?,
        category_filter?,
        color_filter?,
        style_filter?
    )
    requires: user.status = active
    let owned_items = wardrobe/WardrobeItems where
        owner = user and status = active
    requires: owned_items.count >= config.min_items_to_unlock_sharing
    ensures: WardrobeShowcaseCard.created(
        owner: user,
        showcase_mode: showcase_mode,
        category_filter: category_filter,
        color_filter: color_filter,
        style_filter: style_filter,
        theme: theme,
        caption: caption,
        status: live,
        created_at: now
    )
}

rule GenerateStyleStatsCard {
    when: GenerateStyleStatsCard(user, period, theme, caption?)
    requires: user.status = active
    let owned_items = wardrobe/WardrobeItems where
        owner = user and status = active
    requires: owned_items.count >= config.min_items_to_unlock_sharing
    ensures: StyleStatsCard.created(
        owner: user,
        period: period,
        theme: theme,
        caption: caption,
        status: live,
        created_at: now
    )
}

-- User updates the caption before posting.
rule UpdateCardCaption {
    when: UpdateCardCaption(card, caption)
    requires: card.status = live
    ensures: card.caption = caption
}

-- User posts the card to a specific platform. Multiple platform posts per
-- card are allowed.
rule PostCardToPlatform {
    when: PostCardToPlatform(card, platform)
    requires: card.status = live
    ensures: ShareEvent.created(
        card: card,
        platform: platform,
        occurred_at: now
    )
}

-- A third party clicks on a shared link. Anonymous by default; may be
-- associated with a new user if they subsequently sign up.
rule RecordShareClick {
    when: RecordShareClick(card, platform)
    requires: card.status = live
    ensures: ShareClick.created(
        card: card,
        platform: platform,
        occurred_at: now,
        converted_to_signup: false,
        referred_user: null
    )
}

-- When a click converts (the clicker signs up via the deep link).
rule AttributeClickToSignup {
    when: AttributeClickToSignup(click, new_user)
    requires: not click.converted_to_signup
    requires: new_user.status in {pending_verification, active}
    ensures:
        click.converted_to_signup = true
        click.referred_user = new_user
}

-- A live card ages out past its TTL.
rule ExpireShareableCard {
    when: card: ShareableCard.created_at + config.card_ttl <= now
    requires: card.status = live
    ensures:
        card.status = expired
        card.expired_at = now
}

-- decision: account deletion hard-deletes every ShareableCard owned by the
-- user and, via the card, every ShareEvent and ShareClick attached to it.
-- ShareClicks that referred the deleted user are unlinked (referred_user
-- cleared) but kept for anonymous referral analytics.
rule CascadeUserDeletionToShareAssets {
    when: UserDeleted(deleted_user)
    let cards = ShareableCards where owner = deleted_user
    let events = ShareEvents where card.owner = deleted_user
    let clicks = ShareClicks where card.owner = deleted_user
    let referrals = ShareClicks where referred_user = deleted_user
    ensures:
        for e in events: not exists e
        for k in clicks: not exists k
        for c in cards: not exists c
        for r in referrals: r.referred_user = null
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ShowcaseModeMatchesFilter {
    for c in ShareableCards:
        c.kind = WardrobeShowcaseCard implies
            (c.showcase_mode = by_category implies c.category_filter != null)
            and (c.showcase_mode = by_color implies c.color_filter != null)
            and (c.showcase_mode = by_style implies c.style_filter != null)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Sharer {
    identified_by: auth/User where status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ShareCompose {
    facing user: Sharer

    context sharer: auth/User where status = active

    let owned_items = wardrobe/WardrobeItems where
        owner = sharer and status = active
    let sharing_unlocked = owned_items.count >= config.min_items_to_unlock_sharing

    exposes:
        sharing_unlocked
        owned_items.count

    provides:
        GenerateOutfitCard(sharer, outfit, theme) when sharing_unlocked
        GenerateWardrobeShowcaseCard(sharer, showcase_mode, theme)
            when sharing_unlocked
        GenerateStyleStatsCard(sharer, period, theme) when sharing_unlocked
}

surface CardPreview {
    facing user: Sharer

    context card: ShareableCard

    exposes:
        card.theme
        card.caption
        card.created_at

    provides:
        UpdateCardCaption(card, caption) when card.status = live
        PostCardToPlatform(card, platform) when card.status = live

    timeout:
        ExpireShareableCard
}

surface ShareAnalytics {
    facing user: Sharer

    context owner: auth/User where status = active

    let cards = ShareableCards where owner = owner

    exposes:
        for c in cards:
            c.share_count
            c.click_count
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should a card expire when its underlying outfit is deleted, or continue to exist as an archive?"
open question "Are ShareClick records retained indefinitely for analytics, or subject to a retention window?"
