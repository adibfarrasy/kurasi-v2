-- allium: 3
-- style-board.allium

-- Scope: the curated inspiration feed (Tinder-style swipe), user saves and the
-- personal style board collection. Content is curated by the platform; users do
-- not upload to the style board themselves.
--
-- Includes:
--   - StyleCard: curated inspiration images
--   - User interaction history (like/skip) to drive recommendations and avoid
--     showing the same card twice
--   - SavedStyle: an entry in the user's personal board
-- Excludes:
--   - UI mechanics of the swipe gesture
--   - Recommendation ranking algorithm (black-box; consumes StyleInteractions
--     as a signal)
--   - Moderation/licensing workflow for curated content (content is assumed
--     admitted)
--   - Public Discover feed of other users' outfits (that belongs with fit-page
--     sharing)

use "./auth.allium" as auth


------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum InteractionKind {
    liked
    | skipped
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity StyleCard {
    image_url: String
    title: String?
    description: String?
    source_attribution: String
    created_at: Timestamp
    status: published | retired

    transitions status {
        published -> retired
        terminal: retired
    }

    retired_at: Timestamp when status = retired

    -- All interactions this card has received.
    interactions: StyleInteraction with card = this
    likes: interactions where kind = liked
    like_count: likes.count
}

entity StyleInteraction {
    user: auth/User
    card: StyleCard
    kind: InteractionKind
    occurred_at: Timestamp
}

entity SavedStyle {
    user: auth/User
    card: StyleCard
    saved_at: Timestamp
    status: saved | removed

    transitions status {
        saved -> removed
        terminal: removed
    }

    removed_at: Timestamp when status = removed
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- User swipes right / taps heart on a card: the interaction is recorded and
-- the card is added to their style board.
rule LikeStyleCard {
    when: LikeStyleCard(user, card)
    requires: user.status = active
    requires: card.status = published
    requires: not exists StyleInteraction{user: user, card: card}
    ensures: StyleInteraction.created(
        user: user,
        card: card,
        kind: liked,
        occurred_at: now
    )
    ensures: SavedStyle.created(
        user: user,
        card: card,
        status: saved,
        saved_at: now
    )
}

-- User swipes left / skips a card. No saved entry; the interaction is recorded
-- so the card is not shown again and to inform recommendations.
-- decision: a skip permanently excludes that card from the user's future
-- feed. There is no unskip and no cooldown; once seen-and-skipped, the card
-- is gone from their discovery surface forever.
rule SkipStyleCard {
    when: SkipStyleCard(user, card)
    requires: user.status = active
    requires: card.status = published
    requires: not exists StyleInteraction{user: user, card: card}
    ensures: StyleInteraction.created(
        user: user,
        card: card,
        kind: skipped,
        occurred_at: now
    )
}

-- Remove a card from the user's style board. The like interaction remains
-- (still a signal for recommendations); the saved entry is marked removed.
rule RemoveFromBoard {
    when: RemoveFromBoard(saved)
    requires: saved.status = saved
    ensures:
        saved.status = removed
        saved.removed_at = now
}

-- Admin / content curation: a curated card is retired (taken out of rotation).
-- decision: retiring a card removes it from the discovery feed but leaves
-- every existing SavedStyle referencing it intact. Saves persist even after
-- retirement; users keep what they have saved.
rule RetireStyleCard {
    when: RetireStyleCard(card)
    requires: card.status = published
    ensures:
        card.status = retired
        card.retired_at = now
}

-- decision: account deletion hard-deletes the user's StyleInteractions and
-- SavedStyles. StyleCards (curated content) are untouched.
rule CascadeUserDeletionToStyleBoard {
    when: UserDeleted(deleted_user)
    let interactions = StyleInteractions where user = deleted_user
    let saved = SavedStyles where user = deleted_user
    ensures:
        for i in interactions: not exists i
        for s in saved: not exists s
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A user cannot interact with the same card twice (the feed does not repeat).
invariant AtMostOneInteractionPerUserCard {
    for a in StyleInteractions:
        for b in StyleInteractions:
            a != b implies not (a.user = b.user and a.card = b.card)
}

invariant SavedStyleImpliesLike {
    for s in SavedStyles:
        s.status = saved implies
            exists StyleInteraction{user: s.user, card: s.card}
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor StyleBoardUser {
    identified_by: auth/User where status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface StyleFeed {
    facing viewer: StyleBoardUser

    context user: auth/User where status = active

    -- decision: the feed excludes any card the user has already interacted
    -- with (liked or skipped). A skip is permanent. It also excludes
    -- retired cards (status != published).
    let candidates = StyleCards where
        status = published
        and not exists StyleInteraction{user: user, card: this}

    exposes:
        for card in candidates:
            card.image_url
            card.title
            card.like_count

    provides:
        LikeStyleCard(user, card)
        SkipStyleCard(user, card)
}

surface PersonalStyleBoard {
    facing owner: StyleBoardUser

    context user: auth/User where status = active

    let saved = SavedStyles where user = user and status = saved

    exposes:
        for s in saved:
            s.card.image_url
            s.card.title
            s.saved_at

    provides:
        RemoveFromBoard(saved)
}

