DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5437/postgres
PORT=8989
ENVIRONMENT=dev

# Kratos (self-hosted auth). KRATOS_COOKIE_SECRET / KRATOS_CIPHER_SECRET must be 32 bytes each.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are for the OIDC "google" provider in backend/kratos/kratos.yml.
KRATOS_COOKIE_SECRET=0123456789abcdef0123456789abcdef
KRATOS_CIPHER_SECRET=abcdef0123456789abcdef0123456789
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend env: Kratos JWT verification. KRATOS_JWKS_URL must serve the PUBLIC jwk.json
# (self-hosted Kratos does not expose public keys over HTTP); KRATOS_ISSUER must match
# the tokenizer issuer Kratos signs with (local dev: http://localhost:4433/).
KRATOS_JWKS_URL=http://localhost:4433/jwks.json
KRATOS_ISSUER=http://localhost:4433/
# CLOTHING_DIR=../clothing articles
# AVATAR_DIR=avatar/assets