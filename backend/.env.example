DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5437/postgres
PORT=8989
ENVIRONMENT=dev

# Kratos (self-hosted auth). KRATOS_COOKIE_SECRET / KRATOS_CIPHER_SECRET must be 32 bytes each.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET feed the OIDC "google" provider injected by
# docker compose as a single SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS JSON env var.
KRATOS_COOKIE_SECRET=0123456789abcdef0123456789abcdef
KRATOS_CIPHER_SECRET=abcdef0123456789abcdef0123456789
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend env: Kratos JWT verification. KRATOS_JWKS_URL must serve the PUBLIC jwk.public.json
# (self-hosted Kratos does not expose public keys over HTTP; the `kratos-jwks` compose service
# serves it at http://localhost:4435/jwks.json); KRATOS_ISSUER must match the tokenizer issuer
# Kratos signs with (local dev: http://localhost:4433/). ENVIRONMENT=production fails fast if
# KRATOS_ISSUER is left at the placeholder.
KRATOS_JWKS_URL=http://localhost:4435/jwks.json
KRATOS_ISSUER=http://localhost:4433/
# CLOTHING_DIR=../clothing articles
# AVATAR_DIR=avatar/assets