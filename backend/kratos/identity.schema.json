{
  "$id": "https://kurasi.local/schemas/identity.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "ory.sh/kratos": { "credentials": { "password": { "identifier": true } } }
        },
        "name": { "type": "string" },
        "picture": { "type": "string" }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}