-- allium: 3
-- credits.allium

-- Scope: AI credit balance, grants, and spend lifecycle. Every User has one
-- CreditAccount that accrues credits from signup, subscription drip and
-- one-off purchases, and pays them out when AI operations run.
--
-- Includes:
--   - Signup grant (one-shot, on account activation)
--   - Weekly subscription drip (while subscription is current)
--   - Purchase grants (one-off top-ups)
--   - Reserve-then-debit lifecycle for AI operations (Steal-the-Look,
--     Upload-Wardrobe-Image) with per-image atomicity for batch uploads
--   - Refund-on-failure via hold release
-- Excludes:
--   - IAP processor mechanics (Apple/Google StoreKit, receipt validation)
--   - Dollar pricing and credit-pack catalogue (lives in app config)
--   - Promo/operator grants (deferred; will land as another grant source)
--   - Per-grant expiry (decision: credits never expire)
--   - The AI operations themselves (see wardrobe.allium and the
--     steal-the-look pipeline)

use "./auth.allium" as auth
use "./onboarding.allium" as onboarding
use "./payments.allium" as payments

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The operations that consume credits. Each operation has a fixed cost in
-- config; cost is per-trigger, not per-result.
enum CreditedOperation {
    steal_the_look
    | upload_wardrobe_image
}

-- Provenance of a credit grant. Recorded on each grant for auditability;
-- never affects the credit's spendability (credits are fungible).
enum CreditGrantSource {
    signup
    | weekly_subscription
    | purchase
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One per user. Tracks the running balance plus the anchor used to drip
-- subscription credits weekly.
--
-- decision: holds are modelled as immediate-debit. ReserveCredits deducts
-- the cost from balance at hold creation. Commit (operation succeeded) is
-- a status-only change. Release (operation failed) restores the deducted
-- amount. This keeps `balance` as the single spendable number and avoids
-- a "balance minus active holds" aggregation.
entity CreditAccount {
    user: auth/User
    balance: Integer
    -- decision: anchored to the last successful weekly grant. Initialised on
    -- account creation to (now - weekly_grant_period) so the very first
    -- weekly grant fires immediately on the user's first eligible
    -- evaluation after subscribing. A user who subscribes, lapses, then
    -- resubscribes does not retroactively claim missed weeks; the anchor
    -- advances only on actual grants.
    last_weekly_grant_at: Timestamp
}

-- Append-only record of every grant. Kept for audit + balance reconciliation.
-- Source-tagged so support can answer "where did these credits come from?".
entity CreditGrant {
    user: auth/User
    amount: Integer
    source: CreditGrantSource
    granted_at: Timestamp
}

-- Reserve-then-debit hold. Created at the start of an AI operation, then
-- either committed (operation succeeded, debit is permanent) or released
-- (operation failed/cancelled, deducted amount is restored to balance).
--
-- For batch uploads (Upload Wardrobe with N images), one hold per image.
-- Per-image atomicity means each image's hold commits or releases
-- independently.
entity CreditHold {
    user: auth/User
    amount: Integer
    operation: CreditedOperation
    created_at: Timestamp
    -- decision: hold lifecycle is strictly forward. A hold cannot transition
    -- between committed and released; both are terminal.
    status: held | committed | released

    transitions status {
        held -> committed
        held -> released
        terminal: committed
        terminal: released
    }

    committed_at: Timestamp when status = committed
    released_at: Timestamp when status = released
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    signup_grant: Integer = 15
    weekly_subscription_grant: Integer = 10
    weekly_grant_period: Duration = 7.days

    -- decision: per-operation costs are config so a price change (e.g. a
    -- model upgrade making Steal-the-Look cheaper) does not require a spec
    -- revision. Defaults reflect the locked design.
    cost_steal_the_look: Integer = 6
    cost_upload_wardrobe_image: Integer = 1
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Account creation: every active user gets exactly one CreditAccount with a
-- zero balance and a weekly anchor set in the past so the first
-- post-subscription grant fires immediately.
rule CreateCreditAccount {
    when: user: auth/User.status becomes active
    requires: not exists CreditAccount{user: user}
    ensures: CreditAccount.created(
        user: user,
        balance: 0,
        last_weekly_grant_at: now - config.weekly_grant_period
    )
}

-- One-shot signup grant — fires when onboarding completes (matches the
-- "15 free AI credits" welcome-gift screen at the end of the onboarding
-- flow). Recorded as a CreditGrant with source = signup. The
-- AtMostOneSignupGrant invariant + the not-exists guard make this
-- idempotent.
--
-- decision: tied to onboarding completion rather than account activation
-- because (a) it matches the product flow shown to the user, and (b) it
-- avoids granting credits to accounts that signed up but never onboarded.
rule GrantSignupCredits {
    when: progress: onboarding/OnboardingProgress.status becomes completed
    let account = CreditAccount{user: progress.user}
    requires: exists account
    requires: not exists CreditGrant{user: progress.user, source: signup}
    ensures:
        account.balance = account.balance + config.signup_grant
        CreditGrant.created(
            user: progress.user,
            amount: config.signup_grant,
            source: signup,
            granted_at: now
        )
}

-- Subscription drip: every weekly_grant_period while the user's subscription
-- is_current, drop the weekly grant. Anchor advances on success only.
rule GrantWeeklySubscriptionCredits {
    when: account: CreditAccount.last_weekly_grant_at + config.weekly_grant_period <= now
    let sub = payments/Subscription{user: account.user}
    requires: exists sub
    requires: sub.is_current
    ensures:
        account.balance = account.balance + config.weekly_subscription_grant
        account.last_weekly_grant_at = now
        CreditGrant.created(
            user: account.user,
            amount: config.weekly_subscription_grant,
            source: weekly_subscription,
            granted_at: now
        )
}

-- One-off purchase grant. The IAP processor signal is modelled as the
-- PurchaseCredits trigger; receipt validation happens outside this spec.
rule GrantPurchasedCredits {
    when: PurchaseCredits(user, amount)
    requires: amount > 0
    let account = CreditAccount{user: user}
    requires: exists account
    ensures:
        account.balance = account.balance + amount
        CreditGrant.created(
            user: user,
            amount: amount,
            source: purchase,
            granted_at: now
        )
}

-- Reserve credits for a Steal-the-Look operation. Immediate-debit: balance
-- drops at hold creation; commit is then status-only.
rule ReserveCreditsForStealTheLook {
    when: ReserveCredits(user, steal_the_look)
    let account = CreditAccount{user: user}
    requires: exists account
    requires: account.balance >= config.cost_steal_the_look
    ensures:
        account.balance = account.balance - config.cost_steal_the_look
        CreditHold.created(
            user: user,
            amount: config.cost_steal_the_look,
            operation: steal_the_look,
            created_at: now,
            status: held
        )
}

-- Reserve credits for a single Upload-Wardrobe image. Per-image atomicity:
-- a batch of N images produces N independent ReserveCredits calls and N
-- independent holds, each succeeding or failing on its own.
rule ReserveCreditsForUploadWardrobeImage {
    when: ReserveCredits(user, upload_wardrobe_image)
    let account = CreditAccount{user: user}
    requires: exists account
    requires: account.balance >= config.cost_upload_wardrobe_image
    ensures:
        account.balance = account.balance - config.cost_upload_wardrobe_image
        CreditHold.created(
            user: user,
            amount: config.cost_upload_wardrobe_image,
            operation: upload_wardrobe_image,
            created_at: now,
            status: held
        )
}

-- AI operation succeeded: commit the hold. Balance is already debited from
-- the reserve step; this rule just records the terminal state for audit.
rule CommitHoldOnSuccess {
    when: CommitHold(hold)
    requires: hold.status = held
    ensures:
        hold.status = committed
        hold.committed_at = now
}

-- AI operation failed or was cancelled: release the hold and restore the
-- reserved amount to balance.
rule ReleaseHoldOnFailure {
    when: ReleaseHold(hold)
    requires: hold.status = held
    let account = CreditAccount{user: hold.user}
    requires: exists account
    ensures:
        hold.status = released
        hold.released_at = now
        account.balance = account.balance + hold.amount
}

-- Cascade account deletion: drop the credit account, all grants, all holds.
-- No tombstone — fully wiped on user deletion (mirrors payments cascade).
rule CascadeUserDeletionToCredits {
    when: UserDeleted(deleted_user)
    let account = CreditAccount{user: deleted_user}
    let grants = CreditGrants where user = deleted_user
    let holds = CreditHolds where user = deleted_user
    ensures:
        not exists account
        for g in grants: not exists g
        for h in holds: not exists h
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneCreditAccountPerUser {
    for a in CreditAccounts:
        for b in CreditAccounts:
            a != b implies a.user != b.user
}

-- Balance can never go negative. Combined with the balance >= cost check
-- in the ReserveCredits rules, this ensures a user cannot overdraw.
invariant BalanceNeverNegative {
    for a in CreditAccounts:
        a.balance >= 0
}

-- Each user has at most one signup grant — the spec relies on this to keep
-- GrantSignupCredits idempotent across User reactivation flows.
invariant AtMostOneSignupGrant {
    for g1 in CreditGrants:
        for g2 in CreditGrants:
            (g1 != g2 and g1.source = signup and g2.source = signup)
                implies g1.user != g2.user
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor CreditHolder {
    identified_by: auth/User where status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The AI balance / top-up screen. Shows current spendable balance and lets
-- the user kick off a purchase. The actual dollar prices and pack sizes
-- live in the app's catalogue; this surface only handles the credit amount.
surface AIBalance {
    facing holder: CreditHolder

    context user: auth/User where status = active

    let account = CreditAccount{user: user}

    exposes:
        account.balance

    provides:
        PurchaseCredits(user, amount) when exists account and amount > 0
}

-- Internal surface for AI operations to reserve/commit/release credits.
-- Not user-facing — invoked by Steal-the-Look and Upload-Wardrobe pipelines.
surface CreditLedger {
    facing holder: CreditHolder

    context user: auth/User where status = active

    let account = CreditAccount{user: user}

    exposes:
        account.balance

    provides:
        ReserveCredits(user, operation)
            when exists account
        CommitHold(hold) when hold.user = user and hold.status = held
        ReleaseHold(hold) when hold.user = user and hold.status = held
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Promo / operator grants are out of MVP scope. When they land, do they need a separate trigger (GrantPromoCredits) or can they reuse the purchase pathway with a source flag?"

open question "Is there a per-user purchase cap (anti-fraud) we should encode, e.g. max credits purchased per 24h?"

open question "Subscription lapses mid-week: the user keeps their dripped credits (Never expire). On resubscription, last_weekly_grant_at remains stale, so the next eligible eval immediately drops a new weekly grant. Is that the intended behaviour or should resubscription wait a full period?"
